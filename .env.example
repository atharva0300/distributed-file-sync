# PostgreSQL
POSTGRES_DB=filesync
POSTGRES_USER=filesync
POSTGRES_PASSWORD=<generate: openssl rand -hex 32>

# Spring datasource (used by file-sync-service)
DATABASE_URL=jdbc:postgresql://localhost:5432/filesync
DATABASE_USERNAME=filesync
DATABASE_PASSWORD=<same as POSTGRES_PASSWORD>

# Inter-Service Communication
STORAGE_SERVICE_URL=http://localhost:8081
# Shared HMAC secret file-sync-service uses to sign requests to storage-service's
# /internal/** endpoints (and that storage-service verifies). Change this in any
# non-local environment.
INTERNAL_API_KEY=<generate: openssl rand -hex 32>

# JWT Security
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRATION_MS=86400000

# Storage Service (Port 8081)
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Optional: NOTIFICATIONS_BACKPLANE=redis (only for multiple instances; also set SPRING_DATA_REDIS_HOST and REDIS_HEALTH_ENABLED=true)
